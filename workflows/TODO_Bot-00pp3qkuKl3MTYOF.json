    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nlet rows = items;\nif (items.length === 1 && Array.isArray(items[0].data)) rows = items[0].data;\n\nlet text;\nlet reply_markup;\n\nif (!rows || rows.length === 0) {\n  text = '📭 Открытых задач нет.\\n\\nДобавить новую: /new';\n  reply_markup = { inline_keyboard: [] };\n} else {\n  const lines = rows.map((r, idx) => `${idx+1}. [${r.id}] ${r.text}`);\n  const keyboard = rows.map(r => ([\n    { text: '✅ Done', callback_data: `done:${r.id}` },\n    { text: '🗑 Delete', callback_data: `del:${r.id}` }\n  ]));\n  text = '📌 **Открытые задачи**\\n\\n' + lines.join('\\n') + '\\n\\n' +\n         'Закрыть: `/done <id>`\\nУдалить: `/delete <id>`';\n  reply_markup = { inline_keyboard: keyboard };\n}\n\nreturn [{ chat_id: $json.chat_id, text, reply_markup }];"
      },
