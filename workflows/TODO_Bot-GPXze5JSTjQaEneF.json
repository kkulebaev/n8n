    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nlet rows = items;\nlet text;\n\nif (!rows || rows.length === 0) {\n  text = '📭 Открытых задач нет.\\n\\nДобавить новую: /new';\n} else {\n    const lines = rows.map((r) => `- ${r.text} (<code>${r.id}</code>)`);\n\n  const headline = '📌 <b>Открытые задачи</b>'\n  text = headline + '\\n\\n' + lines.join('\\n');\n}\n\nreturn [{ chat_id: $json.chat_id, text }];"
      },
